# Compiled Java / Maven artifacts
backend/target/
*.class
*.jar
*.war
.m2/

# Python virtual environment & cache
ai-service/__pycache__/
ai-service/*/__pycache__/
ai-service/*/*/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Node.js & React Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configs
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Databases & Runtime Dumps
*.h2.db
*.trace.db
